# ThreatLens Environment Variables
PROJECT_NAME="ThreatLens CTI Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="threatlens-production-secret-key-change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite default for local dev, or PostgreSQL)
DATABASE_URL="sqlite:///./threatlens.db"
# DATABASE_URL="postgresql://threatlens:threatlens_secure_password@localhost:5432/threatlens"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Optional External API Keys (Platform has curated offline/free fallback telemetry)
ABUSEIPDB_API_KEY=""
OTX_API_KEY=""
VIRUSTOTAL_API_KEY=""
SHODAN_API_KEY=""
